# ==============================================================================
# MERCADO PAGO - CONFIGURAÇÃO DE AMBIENTE (SANDBOX / PRODUÇÃO)
# Obtenha suas credenciais em: https://www.mercadopago.com.br/developers/panel/app
# ==============================================================================

# Access Token Privado (ESTRITAMENTE NO SERVIDOR - NUNCA EXPONHA NO CLIENTE)
# Modo Sandbox começa com: TEST-xxxx
# Modo Produção começa com: APP_USR-xxxx
MP_ACCESS_TOKEN=APP_USR-4537940842028656-102019-8ef1cabcc5278448bcf19300974558b0-3782297580

# Chave Pública (Exposta de forma segura para o Frontend)
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-2224b437-df64-4cdd-9e28-860f6d7520e1

# Segredo do Webhook (Para validação do header x-signature contra fraudes)
# Configurado na aba 'Notificações Webhook' do painel do Mercado Pago
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret-token

# Flag para forçar modo Sandbox explicitamente (true ou false)
MP_SANDBOX_MODE=true

# URL base da sua aplicação (usada para redirecionamento após pagamento)
# Local: http://localhost:3000
# Produção: https://sua-loja.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# SUPABASE - BANCO DE DADOS E AUTENTICAÇÃO
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
